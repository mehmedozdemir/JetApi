<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JetApi.Desktop.ViewModels"
             xmlns:v="using:JetApi.Desktop.Views"
             xmlns:c="using:JetApi.Desktop.Controls"
             xmlns:l="using:JetApi.Desktop.Localization"
             xmlns:storage="using:JetApi.Storage"
             x:Class="JetApi.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             x:Name="Root">
  <Grid RowDefinitions="48,Auto,*,26" Background="{DynamicResource App.Background}">
    <!-- Top bar -->
    <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
          <c:Icon Data="{StaticResource Icon.Logo}" Width="22" Height="22" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" />
          <TextBlock Text="JetApi" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Heading}" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="WorkspaceButton" Grid.Column="1" Classes="flat" MinHeight="28" ToolTip.Tip="{l:Tr Top_SwitchWorkspace}"
                AutomationProperties.Name="{l:Tr Top_SwitchWorkspace}" Click="OnWorkspaceButtonClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
            <TextBlock Text="{Binding WorkspaceName}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            <c:Icon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="secondary" MinHeight="28" MaxWidth="520" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="16,0"
                Background="{DynamicResource App.Subtle}" BorderThickness="0" CornerRadius="8" Command="{Binding OpenPaletteCommand}" AutomationProperties.Name="{l:Tr Shortcut_Palette}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Data="{StaticResource Icon.Search}" Width="14" Height="14" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Margin="8,0" Text="{l:Tr Top_Search}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="kbd">
              <TextBlock Text="Ctrl K" />
            </Border>
          </Grid>
        </Button>
        <ComboBox Grid.Column="3" Classes="bare" MinWidth="150" VerticalAlignment="Center" ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding SelectedEnvironment}"
                  AutomationProperties.Name="{l:Tr Side_Environments}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnvironmentOption">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Tone.Success.Fg}" IsVisible="{Binding Key, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0" Spacing="4">
          <!-- Shown only after a check found a newer release (nothing when the app runs without update checks). -->
          <ContentControl Content="{Binding Updates}" VerticalAlignment="Center">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:UpdatesViewModel">
                <v:UpdateButton />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <Button Classes="icon" Width="30" Height="30" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:Tr Settings_TitleShortcut}" AutomationProperties.Name="{l:Tr Settings_Title}">
            <c:Icon Data="{StaticResource Icon.Sliders}" />
          </Button>
          <Button Classes="icon" Width="30" Height="30" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{l:Tr Cmd_ToggleTheme}" AutomationProperties.Name="{l:Tr Cmd_ToggleTheme}">
            <c:Icon Data="{StaticResource Icon.Moon}" />
          </Button>
          <Button Classes="icon" Width="30" Height="30" Command="{Binding ToggleLanguageCommand}" ToolTip.Tip="{l:Tr Cmd_ToggleLanguage}" AutomationProperties.Name="{l:Tr Cmd_ToggleLanguage}">
            <c:Icon Data="{StaticResource Icon.Globe}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Skipped files -->
    <Border Grid.Row="1" Classes="warning" CornerRadius="0" IsVisible="{Binding IsDiagnosticsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:Icon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{DynamicResource Tone.Warning.Fg}" VerticalAlignment="Top" Margin="0,1,10,0" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{Binding DiagnosticsTitle}" />
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="storage:StorageDiagnostic">
                <TextBlock Classes="small" TextWrapping="Wrap">
                  <Run FontFamily="{DynamicResource App.MonoFont}" Text="{Binding FilePath}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Message}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Button Grid.Column="2" Classes="link" Content="{l:Tr Btn_Dismiss}" Command="{Binding DismissDiagnosticsCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="280,1,*">
      <!-- Sidebar: icon rail on the left, the list chosen on it on the right. -->
      <Grid ColumnDefinitions="48,*" MinWidth="220">
        <Border Background="{DynamicResource App.Rail}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
          <StackPanel Spacing="6" Margin="0,10,0,0" HorizontalAlignment="Center">
            <RadioButton Classes="rail" GroupName="sidebar"
                         IsChecked="{Binding SidebarMode, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter=Collections}"
                         ToolTip.Tip="{l:Tr Side_Collections}" AutomationProperties.Name="{l:Tr Side_Collections}">
              <c:Icon Data="{StaticResource Icon.Folder}" Width="17" Height="17" />
            </RadioButton>
            <RadioButton Classes="rail" GroupName="sidebar"
                         IsChecked="{Binding SidebarMode, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter=Environments}"
                         ToolTip.Tip="{l:Tr Side_EnvironmentsTip}" AutomationProperties.Name="{l:Tr Side_Environments}">
              <c:Icon Data="{StaticResource Icon.Layers}" Width="17" Height="17" />
            </RadioButton>
            <RadioButton Classes="rail" GroupName="sidebar"
                         IsChecked="{Binding SidebarMode, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter=History}"
                         ToolTip.Tip="{l:Tr Side_History}" AutomationProperties.Name="{l:Tr Side_History}">
              <c:Icon Data="{StaticResource Icon.Clock}" Width="17" Height="17" />
            </RadioButton>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource App.Sidebar}">
          <Panel>
            <!-- Collections -->
            <Grid RowDefinitions="44,Auto,*" IsVisible="{Binding IsCollectionsMode}">
              <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,0">
                <TextBlock Classes="panel-title" Text="{l:Tr Side_Collections}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:Tr Side_NewCollection}" AutomationProperties.Name="{l:Tr Side_NewCollection}">
                  <c:Icon Data="{StaticResource Icon.Plus}" />
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{l:Tr Cmd_NewHttp}" Command="{Binding NewHttpRequestCommand}" InputGesture="Ctrl+N" />
                      <MenuItem Header="{l:Tr Cmd_NewGrpc}" Command="{Binding NewGrpcRequestCommand}" />
                      <MenuItem Header="{l:Tr Menu_NewFolder}" Command="{Binding NewFolderCommand}" />
                      <Separator />
                      <MenuItem Header="{l:Tr Cmd_NewCollection}" Command="{Binding NewCollectionCommand}" />
                      <MenuItem Header="{l:Tr Cmd_ImportPostman}" Command="{Binding ImportFromPostmanCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBox Grid.Row="1" Classes="filter" Margin="12,0,10,8" Text="{Binding FilterText}" PlaceholderText="{l:Tr Side_Filter}"
                       AutomationProperties.Name="{l:Tr Side_Filter}">
                <TextBox.InnerLeftContent>
                  <c:Icon Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="10,0,0,0" Foreground="{DynamicResource App.TextFaint}" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Panel Grid.Row="2">
                <TreeView x:Name="Tree" ItemsSource="{Binding Collections}" Margin="6,0" Background="Transparent" SelectionMode="Single">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                      <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="Auto,*" Background="Transparent" Height="24" Tag="{Binding}">
                        <!-- Drop hints while a node is dragged (TreeNodeViewModel.DropHint): an outline for "inside", a line above or below. -->
                        <Border Grid.ColumnSpan="2" Margin="-4,0,2,0" CornerRadius="5" BorderThickness="1.5" IsVisible="{Binding IsDropInside}"
                                Background="{DynamicResource App.AccentSoft}" BorderBrush="{DynamicResource App.Accent}" />
                        <Panel Width="44" IsVisible="{Binding IsRequest}">
                          <c:MethodBadge Text="{Binding Badge}" />
                        </Panel>
                        <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource App.TextFaint}"
                                IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontWeight="{Binding IsCollection, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
                        <Panel Grid.ColumnSpan="2" Height="7" VerticalAlignment="Top" Margin="-2,0,2,0" IsVisible="{Binding IsDropBefore}">
                          <Border Height="2" Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource App.Accent}" />
                          <Ellipse Width="7" Height="7" HorizontalAlignment="Left" StrokeThickness="2" Stroke="{DynamicResource App.Accent}" Fill="{DynamicResource App.Sidebar}" />
                        </Panel>
                        <Panel Grid.ColumnSpan="2" Height="7" VerticalAlignment="Bottom" Margin="-2,0,2,0" IsVisible="{Binding IsDropAfter}">
                          <Border Height="2" Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource App.Accent}" />
                          <Ellipse Width="7" Height="7" HorizontalAlignment="Left" StrokeThickness="2" Stroke="{DynamicResource App.Accent}" Fill="{DynamicResource App.Sidebar}" />
                        </Panel>
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel IsVisible="{Binding HasNoCollections}" Margin="16" Spacing="10">
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{l:Tr Side_EmptyCollections}" />
                  <Button Classes="secondary" Content="{l:Tr Cmd_NewCollection}" Command="{Binding NewCollectionCommand}" />
                </StackPanel>
              </Panel>
            </Grid>

            <!-- Environments: the list lives here, the selected one opens in the main area. -->
            <ContentControl Content="{Binding Environments}" IsVisible="{Binding IsEnvironmentsMode}">
              <ContentControl.DataTemplates>
                <DataTemplate x:DataType="vm:EnvironmentsViewModel">
                  <Grid RowDefinitions="44,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,0">
                      <TextBlock Classes="panel-title" Text="{l:Tr Side_Environments}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="icon" Command="{Binding AddEnvironmentCommand}" ToolTip.Tip="{l:Tr Env_New}" AutomationProperties.Name="{l:Tr Env_New}">
                        <c:Icon Data="{StaticResource Icon.Plus}" />
                      </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                      <StackPanel Margin="8,0,8,12" Spacing="1">
                        <ItemsControl ItemsSource="{Binding Environments}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeItemViewModel">
                              <Button Classes="flat" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      MinHeight="28" Command="{Binding SelectCommand}">
                                <Button.KeyBindings>
                                  <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
                                  <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                  <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                                </Button.KeyBindings>
                                <Button.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="{l:Tr Env_MakeActive}" Command="{Binding MakeActiveCommand}" IsVisible="{Binding CanMakeActive}">
<MenuItem.Icon><c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" /></MenuItem.Icon>
</MenuItem>
                                    <MenuItem Header="{l:Tr Menu_Rename}" Command="{Binding RenameCommand}" InputGesture="F2">
<MenuItem.Icon><c:Icon Data="{StaticResource Icon.Edit}" Width="14" Height="14" /></MenuItem.Icon>
</MenuItem>
                                    <MenuItem Header="{l:Tr Menu_Duplicate}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D">
<MenuItem.Icon><c:Icon Data="{StaticResource Icon.Copy}" Width="14" Height="14" /></MenuItem.Icon>
</MenuItem>
                                    <Separator />
                                    <MenuItem Classes="danger" Header="{l:Tr Menu_Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete">
<MenuItem.Icon><c:Icon Data="{StaticResource Icon.Trash}" Width="14" Height="14" /></MenuItem.Icon>
</MenuItem>
                                  </ContextMenu>
                                </Button.ContextMenu>
                                <Grid ColumnDefinitions="18,*,Auto">
                                  <Ellipse Width="7" Height="7" Fill="{DynamicResource Tone.Success.Fg}" IsVisible="{Binding IsActive}" HorizontalAlignment="Left" />
                                  <Ellipse Width="7" Height="7" Stroke="{DynamicResource App.TextFaint}" StrokeThickness="1.5" IsVisible="{Binding !IsActive}" HorizontalAlignment="Left" />
                                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Classes="small" Foreground="{DynamicResource Tone.Success.Fg}" Text="{l:Tr Env_Active}" IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Classes="faint small" Text="{Binding Count}" IsVisible="{Binding !IsActive}" VerticalAlignment="Center" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted small" Margin="8" TextWrapping="Wrap" Text="{l:Tr Env_None}" IsVisible="{Binding HasNoEnvironments}" />
                        <Border Classes="divider" Height="1" Margin="8,10" />
                        <ItemsControl ItemsSource="{Binding OtherScopes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeItemViewModel">
                              <Button Classes="flat" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      MinHeight="28" Command="{Binding SelectCommand}">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="1" Classes="faint small" Text="{Binding Count}" VerticalAlignment="Center" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>

            <!-- History -->
            <Grid RowDefinitions="44,*" IsVisible="{Binding IsHistoryVisible}">
              <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,0">
                <TextBlock Classes="panel-title" Text="{l:Tr Side_History}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="{l:Tr Side_ClearHistory}" Command="{Binding ClearHistoryCommand}" IsVisible="{Binding !HasNoHistory}" />
              </Grid>
              <Panel Grid.Row="1">
                <ListBox ItemsSource="{Binding HistoryItems}" Background="Transparent" Margin="6,0" x:Name="HistoryList" DoubleTapped="OnHistoryDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                      <Grid ColumnDefinitions="44,*" Margin="6,6">
                        <c:MethodBadge Text="{Binding Badge}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="mono muted" FontSize="{DynamicResource App.FontSize.Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" FontSize="{DynamicResource App.FontSize.Caption}" Text="{Binding Meta}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="muted small" Margin="16" TextWrapping="Wrap" Text="{l:Tr Side_EmptyHistory}" IsVisible="{Binding HasNoHistory}" />
              </Panel>
            </Grid>
          </Panel>
        </Border>
      </Grid>

      <Border Grid.Column="1" Classes="divider" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Editor area -->
      <Grid Grid.Column="2" RowDefinitions="38,*">
        <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{l:Tr Btn_NewTab}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <!-- Tabs are text on the surface; the active one is marked only by an accent underline. -->
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="12,0,6,0" />
                  <Setter Property="Height" Value="37" />
                  <Setter Property="CornerRadius" Value="0" />
                  <Setter Property="BorderThickness" Value="0,0,0,2" />
                  <Setter Property="BorderBrush" Value="Transparent" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource App.Hover}" />
                </Style>
                <Style Selector="ListBoxItem" x:DataType="vm:RequestTabViewModel">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
                <Style Selector="ListBoxItem TextBlock.tab-title">
                  <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.tab-title">
                  <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                  <Setter Property="FontWeight" Value="Medium" />
                </Style>
                <!-- Close shows on the active or hovered tab; Ctrl+W closes from the keyboard. -->
                <Style Selector="ListBoxItem Button.tab-close">
                  <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:selected Button.tab-close, ListBoxItem:pointerover Button.tab-close, ListBoxItem Button.tab-close:focus-visible">
                  <Setter Property="Opacity" Value="1" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RequestTabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:MethodBadge Text="{Binding Badge}" />
                    <TextBlock Classes="tab-title" Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource App.Accent}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center"
                             ToolTip.Tip="{l:Tr Req_Unsaved}" />
                    <Button Classes="icon tab-close" Width="22" Height="22" Command="{Binding CloseCommand}"
                            AutomationProperties.Name="{l:Tr Btn_Close}" ToolTip.Tip="{l:Tr Shortcut_Close}">
                      <c:Icon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="icon" Width="38" Height="37" Command="{Binding NewHttpRequestCommand}" ToolTip.Tip="{l:Tr Btn_NewTab}" AutomationProperties.Name="{l:Tr Btn_NewTab}">
              <c:Icon Data="{StaticResource Icon.Plus}" />
            </Button>
          </Grid>
        </Border>

        <Panel Grid.Row="1">
          <ContentControl x:Name="Editor" Content="{Binding SelectedTab}">
            <ContentControl.DataTemplates>
              <DataTemplate x:DataType="vm:HttpRequestTabViewModel">
                <v:HttpRequestView />
              </DataTemplate>
              <DataTemplate x:DataType="vm:GrpcRequestTabViewModel">
                <v:GrpcRequestView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>

          <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <c:Icon Data="{StaticResource Icon.Logo}" Width="40" Height="40" Foreground="{DynamicResource App.TextFaint}" HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="Auto,24,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center">
              <TextBlock Classes="muted" Text="{l:Tr Shortcut_Palette}" Margin="0,4" />
              <Border Grid.Column="2" Classes="kbd" Margin="0,3"><TextBlock Text="Ctrl K" /></Border>
              <TextBlock Grid.Row="1" Classes="muted" Text="{l:Tr Shortcut_New}" Margin="0,4" />
              <Border Grid.Row="1" Grid.Column="2" Classes="kbd" Margin="0,3"><TextBlock Text="Ctrl N" /></Border>
              <TextBlock Grid.Row="2" Classes="muted" Text="{l:Tr Shortcut_Send}" Margin="0,4" />
              <Border Grid.Row="2" Grid.Column="2" Classes="kbd" Margin="0,3"><TextBlock Text="Ctrl ↵" /></Border>
              <TextBlock Grid.Row="3" Classes="muted" Text="{l:Tr Shortcut_Save}" Margin="0,4" />
              <Border Grid.Row="3" Grid.Column="2" Classes="kbd" Margin="0,3"><TextBlock Text="Ctrl S" /></Border>
              <TextBlock Grid.Row="4" Classes="muted" Text="{l:Tr Shortcut_Env}" Margin="0,4" />
              <Border Grid.Row="4" Grid.Column="2" Classes="kbd" Margin="0,3"><TextBlock Text="Ctrl E" /></Border>
            </Grid>
          </StackPanel>
        </Panel>

        <ContentControl Grid.RowSpan="2" Content="{Binding Environments}" IsVisible="{Binding Environments, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="vm:EnvironmentsViewModel">
              <v:EnvironmentsView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.RowSpan="2" Content="{Binding NodeSettings}" IsVisible="{Binding NodeSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="vm:NodeSettingsViewModel">
              <v:NodeSettingsView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.RowSpan="2" Content="{Binding CollectionRun}" IsVisible="{Binding CollectionRun, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="vm:CollectionRunViewModel">
              <v:CollectionRunView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding RootPath}">
          <c:Icon Data="{StaticResource Icon.Folder}" Width="12" Height="12" Foreground="{DynamicResource App.TextFaint}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding RootDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0" IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <c:Icon Data="{StaticResource Icon.Branch}" Width="12" Height="12" Foreground="{DynamicResource App.TextFaint}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding GitBranch}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding UnsavedText}" />
          <Button x:Name="ResponsePaneButton" Classes="icon" Width="22" Height="22" VerticalAlignment="Center" Command="{Binding ToggleResponsePaneCommand}"
                  ToolTip.Tip="{Binding ResponsePaneToggleText}" AutomationProperties.Name="{Binding ResponsePaneToggleText}">
            <Panel>
              <c:Icon Data="{StaticResource Icon.LayoutRows}" Width="14" Height="14" IsVisible="{Binding !IsResponseBelow}" />
              <c:Icon Data="{StaticResource Icon.LayoutColumns}" Width="14" Height="14" IsVisible="{Binding IsResponseBelow}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Command palette -->
    <ContentControl Grid.RowSpan="4" Content="{Binding Palette}" IsVisible="{Binding Palette, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate x:DataType="vm:CommandPaletteViewModel">
          <v:CommandPaletteView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</UserControl>
