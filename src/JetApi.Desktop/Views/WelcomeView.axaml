<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JetApi.Desktop.ViewModels"
             xmlns:c="using:JetApi.Desktop.Controls"
             xmlns:l="using:JetApi.Desktop.Localization"
             x:Class="JetApi.Desktop.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel"
             x:Name="Root">
  <Grid RowDefinitions="48,*" Background="{DynamicResource App.Background}">
    <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Data="{StaticResource Icon.Logo}" Width="22" Height="22" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" />
          <TextBlock Text="JetApi" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="2" Classes="segment" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="pill" GroupName="lang" Content="TR" IsChecked="{Binding IsTurkish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="tr" />
            <RadioButton Classes="pill" GroupName="lang" Content="EN" IsChecked="{Binding !IsTurkish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <!-- One column, vertically centred; the main action is the only filled button. -->
      <StackPanel MaxWidth="760" Margin="24,40,24,64" Spacing="32" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Classes="h1" Text="{l:Tr Welcome_Title}" />
          <TextBlock Classes="muted" FontSize="14" LineHeight="22" TextWrapping="Wrap" Text="{l:Tr Welcome_Subtitle}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <Button Classes="primary" MinHeight="40" Padding="18,0" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{l:Tr Welcome_OpenHint}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{StaticResource Icon.Folder}" Width="15" Height="15" Foreground="{DynamicResource App.AccentForeground}" />
              <TextBlock Text="{l:Tr Welcome_Open}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="secondary" MinHeight="40" Padding="16,0" Margin="12,0,0,0" Command="{Binding CreateWorkspaceCommand}" ToolTip.Tip="{l:Tr Welcome_CreateHint}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" />
              <TextBlock Text="{l:Tr Welcome_Create}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="{l:Tr Welcome_ImportHint}">
            <TextBlock Classes="faint small" Text="{l:Tr Welcome_Import}" VerticalAlignment="Center" />
            <Border Classes="badge">
              <TextBlock Text="v0.2" />
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{l:Tr Welcome_Recent}" />
          <Border Background="{DynamicResource App.Surface}" CornerRadius="10" ClipToBounds="True">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentItemViewModel">
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="flat" HorizontalAlignment="Stretch" Padding="16,10" CornerRadius="0"
                                Command="{Binding OpenCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <c:Icon Data="{StaticResource Icon.Folder}" Width="16" Height="16" Foreground="{DynamicResource App.TextFaint}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                              <TextBlock Classes="mono faint" FontSize="12" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="faint small" VerticalAlignment="Center" Text="{Binding LastOpened}" />
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="icon" Margin="8,0" ToolTip.Tip="{l:Tr Welcome_RemoveRecent}" AutomationProperties.Name="{l:Tr Welcome_RemoveRecent}"
                                Command="{Binding RemoveCommand}">
                          <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Margin="16,14" Text="{l:Tr Welcome_NoRecent}" IsVisible="{Binding HasNoRecent}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*">
          <c:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14" Foreground="{DynamicResource App.TextFaint}" VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Grid.Column="1" Classes="faint small" TextWrapping="Wrap" LineHeight="19" Text="{l:Tr Welcome_GitTip}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
