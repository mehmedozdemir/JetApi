<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JetApi.Desktop.ViewModels"
             xmlns:c="using:JetApi.Desktop.Controls"
             xmlns:l="using:JetApi.Desktop.Localization"
             x:Class="JetApi.Desktop.Views.EnvironmentsView"
             x:DataType="vm:EnvironmentsViewModel"
             x:Name="Root">
  <!-- The selected environment or global scope; the list is in the sidebar (Environments on the rail). -->
  <Grid RowDefinitions="48,*" Background="{DynamicResource App.Surface}">
    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="28,0">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Classes="faint" Text="{l:Tr Env_Breadcrumb}" />
        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,24" Spacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding Title}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="mono faint" FontSize="12" Text="{Binding FileName}" />
              <TextBlock Classes="faint small" Text="{l:Tr Env_Unsaved}" IsVisible="{Binding IsDirty}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding RevealSecrets}" Content="{l:Tr Env_Reveal}" />
            <Button Classes="secondary" Content="{l:Tr Env_MakeActive}" Command="{Binding MakeActiveCommand}" IsVisible="{Binding CanMakeActive}" />
            <Button Classes="primary" Content="{l:Tr Btn_Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />
          </StackPanel>
        </Grid>

        <Border Classes="warning" IsVisible="{Binding ShowProductionWarning}">
          <Grid ColumnDefinitions="Auto,*">
            <c:Icon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Foreground="{DynamicResource Tone.Warning.Fg}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18" Text="{l:Tr Env_ProdWarning}" />
          </Grid>
        </Border>

        <StackPanel>
          <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="40,*,*,*,64,36" Height="34">
              <TextBlock Grid.Column="1" Classes="faint small" Margin="6,0" VerticalAlignment="Center" Text="{l:Tr Env_Name}" />
              <TextBlock Grid.Column="2" Classes="faint small" Margin="6,0" VerticalAlignment="Center" Text="{l:Tr Req_Value}" />
              <TextBlock Grid.Column="3" Classes="faint small" Margin="6,0" VerticalAlignment="Center" Text="{l:Tr Env_Resolved}" />
              <TextBlock Grid.Column="4" Classes="faint small" VerticalAlignment="Center" Text="{l:Tr Env_Secret}" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VariableRowViewModel">
                <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="40,*,*,*,64,36" MinHeight="38">
                    <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" IsVisible="{Binding !IsPlaceholder}" />
                    <TextBox Grid.Column="1" Classes="cell mono" Text="{Binding Name}" PlaceholderText="{l:Tr Env_AddVariable}" />
                    <Panel Grid.Column="2">
                      <TextBox Classes="cell mono" Text="{Binding Value}" IsVisible="{Binding !IsMasked}" />
                      <TextBox Classes="cell mono" Text="{Binding Value}" IsVisible="{Binding IsMasked}" PasswordChar="•" />
                    </Panel>
                    <TextBlock Grid.Column="3" Classes="mono muted" Margin="6,0" VerticalAlignment="Center" Text="{Binding Resolved}" TextTrimming="CharacterEllipsis" />
                    <CheckBox Grid.Column="4" IsChecked="{Binding IsSecret}" IsVisible="{Binding !IsPlaceholder}" />
                    <Button Grid.Column="5" Classes="icon" IsVisible="{Binding !IsPlaceholder}" AutomationProperties.Name="{l:Tr Btn_Remove}"
                            ToolTip.Tip="{l:Tr Btn_Remove}" Command="{Binding RemoveCommand}">
                      <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="19" Text="{l:Tr Env_PrecedenceLine}" />
        <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="19" Text="{l:Tr Env_DynamicHint}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
