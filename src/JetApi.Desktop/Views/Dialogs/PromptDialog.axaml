<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:JetApi.Desktop.Localization"
        x:Class="JetApi.Desktop.Views.Dialogs.PromptDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.Surface}">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="h3" />
    <StackPanel Spacing="4">
      <TextBlock x:Name="LabelText" Classes="field-label" />
      <TextBox x:Name="Input" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="secondary" Content="{l:Tr Btn_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button x:Name="OkButton" Classes="primary" Content="{l:Tr Btn_Ok}" IsDefault="True" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
