<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:JetApi.Desktop.Localization"
        xmlns:c="using:JetApi.Desktop.Controls"
        xmlns:vm="using:JetApi.Desktop.ViewModels"
        x:Class="JetApi.Desktop.Views.Dialogs.ReleaseNotesDialog"
        x:DataType="vm:ReleaseNotesViewModel"
        Width="760" Height="680" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{Binding Title}"
        Background="{DynamicResource App.Surface}">
  <!-- What changed in each version, from the changelog shipped with the app (no network). -->
  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="28,24,28,18">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource App.AccentSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
          <c:Icon Data="{StaticResource Icon.Sparkle}" Width="20" Height="20" Foreground="{DynamicResource App.Accent}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          <TextBlock Classes="faint small" Text="{l:Tr Notes_LanguageNote}" TextWrapping="Wrap" IsVisible="{Binding ShowsLanguageNote}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Panel Margin="28,22,28,4">
        <ItemsControl ItemsSource="{Binding Sections}" AutomationProperties.Name="{l:Tr Notes_Title}" />
        <TextBlock Classes="muted" Text="{l:Tr Notes_Empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />
      </Panel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid ColumnDefinitions="*,Auto">
        <Button Classes="link" Content="{l:Tr Notes_AllReleases}" Click="OnAllReleases" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Padding="22,0" MinHeight="32" Content="{l:Tr Btn_Close}" Click="OnClose" IsDefault="True" IsCancel="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
