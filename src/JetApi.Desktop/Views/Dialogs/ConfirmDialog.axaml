<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:JetApi.Desktop.Localization"
        x:Class="JetApi.Desktop.Views.Dialogs.ConfirmDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.Surface}">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="h3" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Classes="muted" LineHeight="19" />
    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Classes="secondary" Content="{l:Tr Btn_Cancel}" IsCancel="True" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Classes="primary" IsDefault="True" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
