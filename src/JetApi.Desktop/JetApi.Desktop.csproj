<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>JetApi desktop application (Avalonia).</Description>
    <AssemblyName>JetApi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JetApi.Core\JetApi.Core.csproj" />
    <ProjectReference Include="..\JetApi.Storage\JetApi.Storage.csproj" />
    <ProjectReference Include="..\JetApi.Http\JetApi.Http.csproj" />
    <ProjectReference Include="..\JetApi.Grpc\JetApi.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
