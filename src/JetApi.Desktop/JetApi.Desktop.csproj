<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>JetApi desktop application (Avalonia).</Description>
    <AssemblyName>JetApi</AssemblyName>
    <RootNamespace>JetApi.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/jetapi.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- View model members are bound from XAML, which needs instance members even when they read only static state. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>
  <!-- Packaging (build/package.sh); the target runtimes are listed in src/Directory.Build.props. -->
  <PropertyGroup>
    <!-- Always on, so the analyzer package is in the lock file and single-file problems show up in normal builds. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompiled code shortens cold start (NFR-1). Trimming stays off: YAML and proto loading use reflection. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/jetapi.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JetApi.Core\JetApi.Core.csproj" />
    <ProjectReference Include="..\JetApi.Storage\JetApi.Storage.csproj" />
    <ProjectReference Include="..\JetApi.Http\JetApi.Http.csproj" />
    <ProjectReference Include="..\JetApi.Grpc\JetApi.Grpc.csproj" />
    <ProjectReference Include="..\JetApi.Import\JetApi.Import.csproj" />
    <ProjectReference Include="..\JetApi.Testing\JetApi.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JetApi.Desktop.Tests" />
  </ItemGroup>
</Project>
