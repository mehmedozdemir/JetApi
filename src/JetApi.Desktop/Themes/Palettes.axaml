<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Color palettes besides the default one in Tokens.axaml (Services/ThemePalettes.cs). Each overrides every color token
     of its variant; App.SyntaxTheme names the TextMate theme of the code editor. Loaded only when a palette is chosen. -->
  <ResourceDictionary x:Key="solarized-light">
    <x:String x:Key="App.SyntaxTheme">SolarizedLight</x:String>
    <SolidColorBrush x:Key="App.Background" Color="#F3EDDA" />
