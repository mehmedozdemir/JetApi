<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens from docs/ui-design.md. Every color used by the views comes from here. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="App.Background" Color="#F6F7F9" />
      <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="App.Sidebar" Color="#F6F7F9" />
      <SolidColorBrush x:Key="App.Border" Color="#E6E8EC" />
      <SolidColorBrush x:Key="App.BorderStrong" Color="#D5D8DE" />
      <SolidColorBrush x:Key="App.Text" Color="#1A1D23" />
      <SolidColorBrush x:Key="App.TextMuted" Color="#5B6170" />
      <SolidColorBrush x:Key="App.TextFaint" Color="#6B7180" />
      <SolidColorBrush x:Key="App.Accent" Color="#3451D1" />
      <SolidColorBrush x:Key="App.AccentHover" Color="#22389E" />
      <SolidColorBrush x:Key="App.AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="App.AccentSoft" Color="#EEF1FD" />
      <SolidColorBrush x:Key="App.Selection" Color="#E9EBF8" />
      <SolidColorBrush x:Key="App.Hover" Color="#EEF0F3" />
      <SolidColorBrush x:Key="App.Code" Color="#F6F7F9" />
      <SolidColorBrush x:Key="App.Subtle" Color="#EDEEF2" />
      <SolidColorBrush x:Key="App.Overlay" Color="#801A1D23" />

      <SolidColorBrush x:Key="Tone.Neutral.Bg" Color="#F2F3F5" />
      <SolidColorBrush x:Key="Tone.Neutral.Fg" Color="#5B6170" />
      <SolidColorBrush x:Key="Tone.Success.Bg" Color="#E8F5EC" />
      <SolidColorBrush x:Key="Tone.Success.Fg" Color="#1B5E2B" />
      <SolidColorBrush x:Key="Tone.Info.Bg" Color="#EEF1FD" />
      <SolidColorBrush x:Key="Tone.Info.Fg" Color="#22389E" />
      <SolidColorBrush x:Key="Tone.Warning.Bg" Color="#FFF4E5" />
      <SolidColorBrush x:Key="Tone.Warning.Fg" Color="#6B2E00" />
      <SolidColorBrush x:Key="Tone.Danger.Bg" Color="#FDECEC" />
      <SolidColorBrush x:Key="Tone.Danger.Fg" Color="#8F1D1D" />

      <SolidColorBrush x:Key="Method.GET" Color="#237032" />
      <SolidColorBrush x:Key="Method.POST" Color="#A64B00" />
      <SolidColorBrush x:Key="Method.PUT" Color="#1D4ED8" />
      <SolidColorBrush x:Key="Method.PATCH" Color="#7C3AED" />
      <SolidColorBrush x:Key="Method.DELETE" Color="#B91C1C" />
      <SolidColorBrush x:Key="Method.gRPC" Color="#0F766E" />
      <SolidColorBrush x:Key="Method.Other" Color="#5B6170" />

      <SolidColorBrush x:Key="Timing.Dns" Color="#A3A8B3" />
      <SolidColorBrush x:Key="Timing.Connect" Color="#0F766E" />
      <SolidColorBrush x:Key="Timing.FirstByte" Color="#3451D1" />
      <SolidColorBrush x:Key="Timing.Download" Color="#A64B00" />
      <SolidColorBrush x:Key="Timing.Total" Color="#5B6170" />
      <SolidColorBrush x:Key="Timing.Track" Color="#F0F1F4" />
      <!-- Rail, segmented controls and checked boxes (makeover, 2026-11). -->
      <SolidColorBrush x:Key="App.Rail" Color="#EFF0F3" />
      <SolidColorBrush x:Key="App.SegmentSelected" Color="#FFFFFF" />
      <SolidColorBrush x:Key="App.Check" Color="#1A1D23" />
      <SolidColorBrush x:Key="App.CheckForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="App.Danger" Color="#B42318" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#1A1D23" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#2E323B" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3A3F4A" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#1A1D23" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#2E323B" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#3A3F4A" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="App.Background" Color="#13151A" />
      <SolidColorBrush x:Key="App.Surface" Color="#181B21" />
      <SolidColorBrush x:Key="App.Sidebar" Color="#13151A" />
      <SolidColorBrush x:Key="App.Border" Color="#2A2E37" />
      <SolidColorBrush x:Key="App.BorderStrong" Color="#3A3F4A" />
      <SolidColorBrush x:Key="App.Text" Color="#E6E8EC" />
      <SolidColorBrush x:Key="App.TextMuted" Color="#A0A6B2" />
      <SolidColorBrush x:Key="App.TextFaint" Color="#8B92A0" />
      <SolidColorBrush x:Key="App.Accent" Color="#7C93F5" />
      <SolidColorBrush x:Key="App.AccentHover" Color="#9AACF8" />
      <SolidColorBrush x:Key="App.AccentForeground" Color="#0B1020" />
      <SolidColorBrush x:Key="App.AccentSoft" Color="#1F2640" />
      <SolidColorBrush x:Key="App.Selection" Color="#232B47" />
      <SolidColorBrush x:Key="App.Hover" Color="#20232A" />
      <SolidColorBrush x:Key="App.Code" Color="#13151A" />
      <SolidColorBrush x:Key="App.Subtle" Color="#23262D" />
      <SolidColorBrush x:Key="App.Overlay" Color="#B0000000" />

      <SolidColorBrush x:Key="Tone.Neutral.Bg" Color="#23262D" />
      <SolidColorBrush x:Key="Tone.Neutral.Fg" Color="#A0A6B2" />
      <SolidColorBrush x:Key="Tone.Success.Bg" Color="#13301D" />
      <SolidColorBrush x:Key="Tone.Success.Fg" Color="#7DD39A" />
      <SolidColorBrush x:Key="Tone.Info.Bg" Color="#1F2640" />
      <SolidColorBrush x:Key="Tone.Info.Fg" Color="#9AACF8" />
      <SolidColorBrush x:Key="Tone.Warning.Bg" Color="#3A2A12" />
      <SolidColorBrush x:Key="Tone.Warning.Fg" Color="#F2B866" />
      <SolidColorBrush x:Key="Tone.Danger.Bg" Color="#3B1717" />
      <SolidColorBrush x:Key="Tone.Danger.Fg" Color="#F19A9A" />

      <SolidColorBrush x:Key="Method.GET" Color="#5CC27A" />
      <SolidColorBrush x:Key="Method.POST" Color="#F0A04B" />
      <SolidColorBrush x:Key="Method.PUT" Color="#6AA0FF" />
      <SolidColorBrush x:Key="Method.PATCH" Color="#B794F6" />
      <SolidColorBrush x:Key="Method.DELETE" Color="#F07575" />
      <SolidColorBrush x:Key="Method.gRPC" Color="#3CC7B5" />
      <SolidColorBrush x:Key="Method.Other" Color="#A0A6B2" />

      <SolidColorBrush x:Key="Timing.Dns" Color="#7A8190" />
      <SolidColorBrush x:Key="Timing.Connect" Color="#3CC7B5" />
      <SolidColorBrush x:Key="Timing.FirstByte" Color="#7C93F5" />
      <SolidColorBrush x:Key="Timing.Download" Color="#F0A04B" />
      <SolidColorBrush x:Key="Timing.Total" Color="#A0A6B2" />
      <SolidColorBrush x:Key="Timing.Track" Color="#23262D" />
      <SolidColorBrush x:Key="App.Rail" Color="#0F1115" />
      <SolidColorBrush x:Key="App.SegmentSelected" Color="#2E323B" />
      <SolidColorBrush x:Key="App.Check" Color="#E6E8EC" />
      <SolidColorBrush x:Key="App.CheckForeground" Color="#0B0D12" />
      <SolidColorBrush x:Key="App.Danger" Color="#F19A9A" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E6E8EC" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#C9CDD5" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E6E8EC" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#C9CDD5" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0B0D12" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0B0D12" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0B0D12" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <StreamGeometry x:Key="Icon.Logo">M4 13l6-2 9-7-3 10-6 2-2 6-2-6z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M3 7h6l2 2h10v10H3z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Search">M11 4a7 7 0 1 0 0.01 0z M20 20l-3.5-3.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5v14 M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Import">M12 3v12 M7 10l5 5 5-5 M4 21h16</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M6 9l6 6 6-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronRight">M9 6l6 6-6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sliders">M4 6h9 M17 6h3 M15 4v4 M4 12h3 M11 12h9 M9 10v4 M4 18h11 M19 18h1 M17 16v4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Clock">M12 3a9 9 0 1 0 0.01 0z M12 7v5l3 2</StreamGeometry>
  <StreamGeometry x:Key="Icon.List">M4 6h16 M4 12h16 M4 18h10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M6 6l12 12 M18 6L6 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M15 6l-6 6 6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Warning">M12 3l10 18H2z M12 10v5 M12 18h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Info">M12 3a9 9 0 1 0 0.01 0z M12 11v5 M12 8h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M5 12l5 5 9-10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Moon">M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Globe">M12 3a9 9 0 1 0 0.01 0z M3 12h18 M12 3c3 3.5 3 14.5 0 18 M12 3c-3 3.5-3 14.5 0 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M20 12a8 8 0 1 1-2.3-5.7 M20 4v6h-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Copy">M9 9h11v11H9z M5 15H4V4h11v1</StreamGeometry>
  <StreamGeometry x:Key="Icon.Save">M5 4h11l3 3v13H5z M8 4v5h7V4 M8 20v-6h8v6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trash">M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Edit">M4 20h4l11-11-4-4L4 16z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Stop">M7 7h10v10H7z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Send">M4 12l16-8-6 16-3-6z M11 14l9-10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Layers">M12 3l9 5-9 5-9-5z M3 13l9 5 9-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Download">M12 4v11 M7 10l5 5 5-5 M5 20h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.More">M5 12h.01 M12 12h.01 M19 12h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Branch">M6 4v12 M6 20a2 2 0 1 0 0.01 0z M18 4a2 2 0 1 0 0.01 0z M18 8c0 5-6 4-12 8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Server">M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01</StreamGeometry>

  <FontFamily x:Key="App.MonoFont">Cascadia Mono, JetBrains Mono, SF Mono, Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
</ResourceDictionary>
