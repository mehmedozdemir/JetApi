<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:JetApi.Desktop.Controls">
  <!-- Shared control looks. Colors always come from Tokens.axaml via DynamicResource so themes switch live. -->

  <!-- The interface font from the settings, for the main window and every dialog. -->
  <Style Selector=":is(Window)">
    <Setter Property="FontFamily" Value="{DynamicResource App.UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Small}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource App.MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Mono}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Display}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Title}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <!-- Flyouts that hold a small form (the variable card). -->
  <Style Selector="FlyoutPresenter.card">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>
  <!-- Code and editor areas: no frame, set apart by a tinted ground. -->
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource App.Code}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <!-- Count or type next to a tab label ("Headers 1", "Body JSON"). -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource App.Subtle}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <!-- Test counts: red when a check failed, green when all passed. -->
  <Style Selector="Border.badge.fail">
    <Setter Property="Background" Value="{DynamicResource Tone.Danger.Bg}" />
  </Style>
  <Style Selector="Border.badge.fail TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tone.Danger.Fg}" />
  </Style>
  <Style Selector="Border.badge.pass">
    <Setter Property="Background" Value="{DynamicResource Tone.Success.Bg}" />
  </Style>
  <Style Selector="Border.badge.pass TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tone.Success.Fg}" />
  </Style>
  <!-- A metric next to the status ("94 ms", "68 B"). -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Tone.Neutral.Bg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource App.MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Small}" />
  </Style>
  <!-- Track of a segmented control; holds RadioButton.pill items. -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource App.Subtle}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- A 1px divider line. -->
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource App.Border}" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="Background" Value="{DynamicResource Tone.Info.Bg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.note TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tone.Info.Fg}" />
  </Style>
  <Style Selector="Border.warning">
    <Setter Property="Background" Value="{DynamicResource Tone.Warning.Bg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tone.Warning.Fg}" />
  </Style>
  <Style Selector="Border.danger">
    <Setter Property="Background" Value="{DynamicResource Tone.Danger.Bg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.danger TextBlock, Border.danger SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tone.Danger.Fg}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource App.MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
  </Style>
  <!-- Plain-text labels on the accent use the accent foreground in both themes (dark text on the light dark-theme accent). -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
  </Style>
  <!-- A disabled main action (nothing to save) stays calm instead of turning into a grey slab. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <!-- Destructive action that is not the main one: red text, no fill. -->
  <Style Selector="Button.danger-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Button.danger-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Tone.Danger.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Tone.Danger.Fg}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Surface}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Small}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentHover}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Section tabs (Params, Headers, ...) -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" Padding="10,0" Height="36" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>
  <Style Selector="RadioButton.tab TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground}" />
  </Style>

  <!-- Segments of a segmented control (body type, pretty/raw/hex); place them in a Border.segment. -->
  <Style Selector="RadioButton.pill">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="9,3">
          <ContentPresenter Content="{TemplateBinding Content}" FontSize="{DynamicResource App.FontSize.Small}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.pill:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="RadioButton.pill:checked">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.pill TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground}" />
  </Style>
  <Style Selector="RadioButton.pill:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource App.SegmentSelected}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #1F1A1D23" />
  </Style>
  <Style Selector="RadioButton.pill:focus-visible /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>

  <!-- Icon rail of the sidebar (collections, environments, history). -->
  <Style Selector="RadioButton.rail">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Width="36" Height="36" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.rail:pointerover /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="RadioButton.rail:checked">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="RadioButton.rail:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource App.SegmentSelected}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #1A1A1D23" />
  </Style>
  <Style Selector="RadioButton.rail:focus-visible /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>

  <!-- Sidebar panel: one-line title, quiet filter, selectable rows. -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Control}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.filter">
    <Setter Property="Background" Value="{DynamicResource App.Subtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Control}" />
  </Style>
  <Style Selector="TextBox.filter:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource App.Subtle}" />
  </Style>
  <Style Selector="Button.flat.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
  </Style>

  <!-- Section list of the settings window. -->
  <Style Selector="RadioButton.navitem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="10,5">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.navitem:pointerover /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="RadioButton.navitem:checked">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.navitem:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>
  <Style Selector="RadioButton.navitem:focus-visible /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Control}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="AutoCompleteBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource App.MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Mono}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource App.MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Mono}" />
    <!-- Hover a {{variable}} to see its value; no-op outside a request tab. -->
    <Setter Property="c:VariableHints.IsEnabled" Value="True" />
  </Style>
  <Style Selector="TextBox.secret">
    <Setter Property="PasswordChar" Value="•" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Control}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
  </Style>
  <!-- One frame around several inputs (method + URL); the frame shows focus for the part inside. -->
  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Border.field:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>
  <Style Selector="TextBox.bare, TextBox.bare:pointerover, TextBox.bare:focus">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.bare">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.bare /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.bare:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="ComboBox.bare /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <!-- Tree -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>

  <!-- An invisible 6px grab area over a 1px Border.divider in the same column; tinted while hovered. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Margin" Value="-3,0" />
    <Setter Property="ZIndex" Value="10" />
    <!-- Invisible, so it should not take keyboard focus while tabbing through the window. -->
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Disabled secondary buttons keep their shape and only fade the label, so they do not look broken. -->
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
  </Style>
</Styles>
