<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>jetapi: runs JetApi collections and folders from the command line, for CI (JUnit XML and HTML reports).</Description>
    <AssemblyName>jetapi</AssemblyName>
    <RootNamespace>JetApi.Cli</RootNamespace>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <!-- A self-contained single file when published for a runtime (build/package.sh, docs/cli.md). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JetApi.Core\JetApi.Core.csproj" />
    <ProjectReference Include="..\JetApi.Storage\JetApi.Storage.csproj" />
    <ProjectReference Include="..\JetApi.Http\JetApi.Http.csproj" />
    <ProjectReference Include="..\JetApi.Grpc\JetApi.Grpc.csproj" />
    <ProjectReference Include="..\JetApi.Testing\JetApi.Testing.csproj" />
    <ProjectReference Include="..\JetApi.Runner\JetApi.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JetApi.Cli.Tests" />
  </ItemGroup>
</Project>
