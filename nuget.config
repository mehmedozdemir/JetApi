<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, whatever feeds are configured on the developer's machine.
  Keeps builds reproducible and avoids NU1507 (several sources with central package management).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
